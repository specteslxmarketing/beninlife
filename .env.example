# Copy to .env (never commit real values)
PORT=3000
NODE_ENV=production
HOST=0.0.0.0
# where the SQLite DB and secret key live (mount a persistent volume here; alias BL_DATA_DIR)
DATA_DIR=/data
# session/JWT secret (otherwise generated once into $DATA_DIR/secret.key; alias BL_SECRET)
# SESSION_SECRET=change-me-64-random-hex-chars
# BEST X admin "bestx" password (>= 12 chars). Unset: a random one is generated (file in DATA_DIR, or logged once on Render)
# ADMIN_PASSWORD=
# cookies are Secure automatically when NODE_ENV=production (needs HTTPS in front); 1/0 forces on/off
# BL_SECURE_COOKIES=1
# behind a TLS-terminating proxy (Render/Railway/Fly/nginx) — default on; set 0 to disable
# BL_TRUST_PROXY=1
# WebRTC (phone calls + proximity voice). Strict NATs need a TURN server, e.g. coturn:
# BL_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"beninlife","credential":"REPLACE_ME"}]
# BL_STUN_URL=stun:stun.l.google.com:19302
